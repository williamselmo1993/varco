      "read": ["clienti", "ordini", "fatture"],
      "write": ["ordini"],
      "soglie": { "ordini": 1000 }
    },
    "sollecitatore": {
      "department": "amministrazione",
      "label": "Recupero Crediti",
      "descrizione": "Controlla lo scadenzario e prepara i solleciti.",
