  },
  "entities": {
    "clienti": { "model": "res.partner", "description": "Anagrafica clienti", "label": "Clienti", "singolare": "un cliente", "campi": ["name", "email", "vat", "phone"] },
    "ordini": { "model": "sale.order", "description": "Ordini di vendita", "label": "Ordini di vendita", "singolare": "un ordine di vendita", "campo_importo": "amount_total", "campi": ["name", "partner_id", "amount_total", "state"] },
    "fatture": { "model": "account.move", "description": "Fatture", "label": "Fatture", "singolare": "una fattura", "campo_importo": "amount_total", "campi": ["name", "partner_id", "amount_total", "invoice_date_due", "payment_state"] },
    "articoli": { "model": "product.template", "description": "Articoli e giacenze", "label": "Articoli", "singolare": "un articolo", "campi": ["name", "default_code", "qty_available", "list_price"] }
  },
  "departments": {
    "vendite": "Vendite",
    "amministrazione": "Amministrazione"
  },
  "agents": {
    "assistente-vendite": {
      "department": "vendite",
      "label": "Assistente Vendite",
      "descrizione": "Dagli ordini ricevuti via email al gestionale.",
